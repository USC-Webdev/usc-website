---
import MinistryMark from './MinistryMark.astro';
import type { SiteNav } from '../lib/types';

interface Props {
  nav: SiteNav;
  currentPath: string;
}
const { nav, currentPath } = Astro.props;
const norm = (p: string) => p.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => norm(href) === norm(currentPath);
// Full-screen overlay over the page; SiteHeader's script opens and closes it.
---

<div id="site-menu" class="overlay" role="dialog" aria-modal="true" aria-label="Menu" hidden>
  <div class="inner wrap">
    <div class="overlay-bar">
      <span class="label">Menu</span>
      <button type="button" class="close" data-menu-close>Close <span aria-hidden="true">✕</span></button>
    </div>
    <nav class="panel" aria-label="Primary">
      <div class="pages">
        {
          nav.pages.map((link) => (
            <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
              {link.label}
            </a>
          ))
        }
      </div>
      <div class="col">
        <a href="/ministries" class="label col-head" aria-current={isCurrent('/ministries') ? 'page' : undefined}>Ministries</a>
        {
          nav.ministries.map((m) => (
            <a href={m.href} class="ministry" aria-current={isCurrent(m.href) ? 'page' : undefined}>
              <span class="mark-slot">
                <MinistryMark mark={m.mark} abbreviation={m.abbreviation} />
              </span>
              {m.label}
            </a>
          ))
        }
      </div>
      <div class="col">
        <a href="/media-network" class="label col-head" aria-current={isCurrent('/media-network') ? 'page' : undefined}>Media Network</a>
        {
          nav.media.map((link) => (
            <a href={link.href} class="media" aria-current={isCurrent(link.href) ? 'page' : undefined}>
              {link.label}
            </a>
          ))
        }
      </div>
    </nav>
  </div>
</div>

<noscript>
  <style>
    #site-menu[hidden] {
      display: block;
      position: static;
      background: none;
    }
    #site-menu .overlay-bar {
      display: none;
    }
  </style>
</noscript>

<style>
  .overlay {
    position: fixed;
    inset: 0;
    z-index: 90;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: rgb(27 46 89 / 0.94);
    backdrop-filter: blur(6px);
    animation: menu-in 0.2s ease-out;
  }
  .overlay[hidden] {
    display: none;
  }
  @keyframes menu-in {
    from {
      opacity: 0;
    }
  }
  .inner {
    padding-top: 16px;
    padding-bottom: 32px;
  }
  .overlay-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    color: var(--white);
    padding-bottom: 16px;
  }
  .close {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: var(--target-min);
    padding: 0 24px;
    border: 1px solid var(--robot-white);
    border-radius: var(--r-control);
    background: transparent;
    color: var(--white);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 14px;
    letter-spacing: var(--track-action);
    text-transform: uppercase;
    cursor: pointer;
  }
  .close:focus-visible {
    outline-color: var(--white);
  }
  .panel {
    background: var(--robot-white);
    color: var(--blue-zodiac);
    padding: clamp(24px, 4vw, 48px);
    display: flex;
    flex-wrap: wrap;
    gap: 32px 56px;
  }
  .panel a {
    text-decoration: none;
    color: var(--blue-zodiac);
  }
  .panel a:hover {
    color: var(--ruby-red);
  }
  .panel :focus-visible {
    outline-color: var(--blue-zodiac);
  }
  .pages {
    flex: 2 1 380px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(1.7rem, 3.8vw, 3.2rem);
    line-height: 1.25;
  }
  .pages a[aria-current='page'] {
    border-bottom: 6px solid var(--ruby-red);
    align-self: flex-start;
  }
  .col {
    flex: 1.2 1 300px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    border-left: var(--rule);
    padding-left: 24px;
  }
  .col:last-child {
    flex: 1 1 220px;
  }
  .col-head {
    padding: 12px 0 10px;
    min-height: var(--target-min);
  }
  .col-head[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--ruby-red);
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }
  .ministry {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 52px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 16px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .mark-slot {
    width: 52px;
    display: flex;
    justify-content: center;
  }
  .media {
    padding: 9px 0;
    min-height: var(--target-min);
    display: flex;
    align-items: center;
  }
  .ministry[aria-current='page'],
  .media[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--ruby-red);
    text-decoration-thickness: 3px;
    text-underline-offset: 6px;
  }
</style>
