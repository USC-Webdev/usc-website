---
// Styles for rendered Markdoc bodies. Pass HTML from renderMarkdoc() or
// slot content.
interface Props {
  html?: string;
  tone?: 'light' | 'dark';
  class?: string;
}
const { html, tone = 'light', class: className } = Astro.props;
---

{
  html !== undefined ? (
    <div class:list={['prose', tone, className]} set:html={html} />
  ) : (
    <div class:list={['prose', tone, className]}>
      <slot />
    </div>
  )
}

<style is:global>
  .prose {
    max-width: 65ch;
    overflow-wrap: anywhere;
    font-size: clamp(17px, 1.3vw, 19px);
    line-height: 1.6;
  }
  .prose.dark {
    color: var(--robot-white);
  }
  .prose > * + * {
    margin-top: 1em;
  }
  .prose h2,
  .prose h3,
  .prose h4 {
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1.2;
    margin-top: 1.6em;
  }
  .prose h2 {
    font-size: 1.6em;
  }
  .prose h3 {
    font-size: 1.3em;
  }
  .prose h4 {
    font-size: 1.1em;
  }
  .prose.dark h2,
  .prose.dark h3,
  .prose.dark h4 {
    color: var(--white);
  }
  .prose ul,
  .prose ol {
    padding-left: 1.3em;
  }
  .prose li + li {
    margin-top: 0.4em;
  }
  .prose li::marker {
    color: var(--ruby-red);
  }
  .prose a {
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }
  .prose blockquote {
    margin-left: 0;
    padding-left: 20px;
    border-left: 4px solid var(--ruby-red);
    font-style: italic;
  }
  .prose hr {
    border: 0;
    border-top: var(--rule);
  }
  .prose table {
    border-collapse: collapse;
    width: 100%;
    display: block;
    overflow-x: auto;
  }
  .prose th,
  .prose td {
    border: var(--rule);
    padding: 8px 12px;
    text-align: left;
  }
</style>
