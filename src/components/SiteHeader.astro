---
import Logo from './Logo.astro';
import MenuPanel from './MenuPanel.astro';
import type { SiteNav, SiteSettings } from '../lib/types';

interface Props {
  nav: SiteNav;
  settings: SiteSettings;
  currentPath: string;
}
const { nav, settings, currentPath } = Astro.props;
---

<div class="site-header on-dark">
  <header class="bar wrap">
    <a href="/home" class="home-link">
      <Logo variant="header" />
    </a>
    <div class="actions">
      <a class="apply" href={settings.applicationUrl} rel="noopener">Application + Discord</a>
      <button type="button" class="menu-btn" aria-expanded="false" aria-controls="site-menu" aria-haspopup="dialog" data-menu-toggle>
        Menu
      </button>
    </div>
  </header>
  <MenuPanel nav={nav} currentPath={currentPath} />
</div>

<script>
  // The menu is a full-screen overlay: opening it locks page scroll and keeps
  // keyboard focus inside; Escape, Close or a click outside the panel closes it.
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('site-menu');
  const close = menu?.querySelector<HTMLButtonElement>('[data-menu-close]');
  if (toggle && menu && close) {
    const focusables = () => [...menu.querySelectorAll<HTMLElement>('a[href], button')];
    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      document.documentElement.style.overflow = open ? 'hidden' : '';
      if (open) close.focus();
      else toggle.focus();
    };
    toggle.addEventListener('click', () => setOpen(true));
    close.addEventListener('click', () => setOpen(false));
    menu.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      if (!target.closest('.panel, .overlay-bar')) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (menu.hidden) return;
      if (event.key === 'Escape') setOpen(false);
      if (event.key === 'Tab') {
        const items = focusables();
        const first = items[0];
        const last = items[items.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    });
  }
</script>

<style>
  .site-header {
    background: var(--blue-zodiac);
    color: var(--white);
  }
  .bar {
    padding-top: 16px;
    padding-bottom: 16px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
  }
  .home-link {
    display: block;
    padding: 8px 8px 8px 0;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }
  .menu-btn,
  .apply {
    display: inline-flex;
    align-items: center;
    height: var(--target-min);
    padding: 0 24px;
    border-radius: var(--r-control);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 14px;
    letter-spacing: var(--track-action);
    text-transform: uppercase;
    text-decoration: none;
    transition: transform 0.25s;
  }
  .menu-btn {
    border: 1px solid var(--robot-white);
    background: transparent;
    color: var(--white);
    cursor: pointer;
  }
  .apply {
    background: var(--white);
    color: var(--blue-zodiac);
  }
  .apply:hover {
    color: var(--blue-zodiac);
  }
  .menu-btn:hover,
  .apply:hover {
    transform: scale(1.05);
  }
  .site-header :focus-visible {
    outline-color: var(--white);
  }
  @media (max-width: 640px) {
    .bar {
      flex-wrap: nowrap;
      gap: 8px;
      padding-top: 12px;
      padding-bottom: 12px;
    }
    .home-link {
      flex: none;
      padding: 4px 0;
    }
    .actions {
      flex-wrap: nowrap;
      gap: 8px;
    }
    .menu-btn,
    .apply {
      padding: 0 clamp(8px, 2.6vw, 14px);
      font-size: clamp(10px, 3vw, 12px);
      letter-spacing: 0.02em;
      white-space: nowrap;
    }
  }
</style>
