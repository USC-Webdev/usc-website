---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Astro Image + caption. SVGs (diagrams) are shown as-is with an "Open full
// size" link, since their labels are small at page width. The "In game image by USC-Citizen: NAME" credit is
// hover text over the image (and the title tooltip); screen readers still get it.
interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  credit?: string;
  sizes?: string;
  eager?: boolean;
}
const { src, alt, caption, credit, sizes = '(min-width: 1392px) 900px, 100vw', eager = false } = Astro.props;
const isSvg = src.format === 'svg';
const widths = [480, 960, 1440, 1920].filter((w) => w <= src.width);
if (widths.length === 0) widths.push(src.width);
const creditText = credit ? `In game image by USC-Citizen: ${credit}` : undefined;
---

<figure class="figure">
  <div class="media" title={creditText}>
    {
      isSvg ? (
        <img src={src.src} alt={alt} width={src.width} height={src.height} loading={eager ? 'eager' : 'lazy'} decoding="async" class="img" />
      ) : (
        <Image src={src} alt={alt} widths={widths} sizes={sizes} loading={eager ? 'eager' : 'lazy'} class="img" />
      )
    }
    {creditText && <span class="credit">{creditText}</span>}
  </div>
  {
    (caption || isSvg) && (
      <figcaption>
        {caption}
        {isSvg && (
          <>
            {' '}
            <a href={src.src} target="_blank" rel="noopener">
              Open full size<span class="visually-hidden"> (opens in a new tab)</span>
            </a>
          </>
        )}
      </figcaption>
    )
  }
</figure>

<style>
  .figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }
  .img {
    width: 100%;
    height: auto;
  }
  .media {
    position: relative;
  }
  figcaption {
    font-size: 15px;
  }
  .credit {
    position: absolute;
    left: 10px;
    bottom: 10px;
    max-width: calc(100% - 20px);
    background: var(--blue-zodiac);
    color: var(--white);
    font-size: 12px;
    letter-spacing: 0.1em;
    line-height: 1.4;
    padding: 4px 8px;
    opacity: 0;
    transition: opacity 0.2s;
  }
  .media:hover .credit {
    opacity: 1;
  }
  /* Touch screens cannot hover, so the credit is always shown there. */
  @media (hover: none) {
    .credit {
      opacity: 1;
    }
  }
</style>
