---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Astro Image + caption + "In game image by USC-Citizen: NAME" credit line.
interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  credit?: string;
  sizes?: string;
  eager?: boolean;
}
const { src, alt, caption, credit, sizes = '(min-width: 1392px) 900px, 100vw', eager = false } = Astro.props;
const widths = [480, 960, 1440, 1920].filter((w) => w <= src.width);
if (widths.length === 0) widths.push(src.width);
---

<figure class="figure">
  <Image src={src} alt={alt} widths={widths} sizes={sizes} loading={eager ? 'eager' : 'lazy'} class="img" />
  {
    (caption || credit) && (
      <figcaption>
        {caption && <span class="caption">{caption}</span>}
        {credit && <span class="credit label">In game image by USC-Citizen: {credit}</span>}
      </figcaption>
    )
  }
</figure>

<style>
  .figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }
  .img {
    width: 100%;
    height: auto;
  }
  figcaption {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 15px;
  }
  .credit {
    font-size: 11px;
    text-transform: none;
    letter-spacing: 0.1em;
  }
</style>
