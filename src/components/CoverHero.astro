---
import { Picture } from 'astro:assets';
import Placeholder from './Placeholder.astro';
import type { HeroImage } from '../lib/types';

// Blue Zodiac cover: full-width image with the white outlined title across it.
// Section links live in the bottom Dock, not here. "small" is the compact
// variant used by the long-form, citizenship and compass templates.
interface Props {
  kicker?: string;
  lines: string[];
  image?: HeroImage;
  size?: 'full' | 'small';
}
const { kicker, lines, image, size = 'full' } = Astro.props;
// Shrink the title so its longest line fits the page width (Orbitron 900 caps are about 1em wide).
const longest = Math.max(...lines.map((l) => l.length), 1);
const fit = `calc((min(100vw, 1392px) - 48px) / ${(longest * 1.04).toFixed(2)})`;
const srcWidth = image?.src?.width ?? 0;
const heroWidths = [640, 960, 1280, 1920, 2560].filter((w) => w <= srcWidth);
if (heroWidths.length === 0 && srcWidth) heroWidths.push(srcWidth);
const creditText = image?.credit ? `In game image by USC-${image.creditStatus ?? 'Citizen'}: ${image.credit}` : undefined;
---

<section class:list={['hero', size, 'on-dark']}>
  <div class="wrap">
    <div class="stage" title={creditText}>
      <figure class="frame">
        {
          image?.src ? (
            <Picture
              src={image.src}
              alt={image.alt}
              formats={['avif', 'webp']}
              widths={heroWidths}
              sizes="100vw"
              loading="eager"
              fetchpriority="high"
              class="photo"
            />
          ) : (
            <Placeholder label="Hero image" ratio="auto" tone="dark" class="photo" />
          )
        }
        {creditText && <figcaption class="credit">{creditText}</figcaption>}
      </figure>
      <h1 class="title" style={`--fit: ${fit}`}>
        {kicker && <span class="kicker">{kicker}</span>}
        {lines.map((line) => <span class="line">{line}</span>)}
      </h1>
    </div>
  </div>
</section>

<style>
  .hero {
    container-type: inline-size;
    background: var(--blue-zodiac);
    color: var(--white);
  }
  .stage {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: clamp(380px, 48vw, 690px);
  }
  .small .stage {
    min-height: clamp(300px, 34vw, 480px);
  }
  /* Full-bleed image behind the title, edge to edge of the hero (cqw excludes the scrollbar). */
  .frame {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 100cqw;
    margin: 0 0 0 -50cqw;
    overflow: hidden;
    background: var(--steel-grey);
  }
  .frame :global(.photo) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .frame :global(picture) {
    display: contents;
  }
  .credit {
    position: absolute;
    left: 50%;
    bottom: 14px;
    transform: translateX(-50%);
    width: max-content;
    max-width: 90%;
    background: var(--blue-zodiac);
    color: var(--white);
    font-size: 12px;
    letter-spacing: 0.1em;
    line-height: 1.4;
    padding: 4px 8px;
    opacity: 0;
    transition: opacity 0.2s;
  }
  /* The credit is hover text on mouse devices: shown while the pointer is over the hero.
     It stays in the page for screen readers, and in the title tooltip. */
  .stage:hover .credit,
  .stage:focus-within .credit {
    opacity: 1;
  }
  /* Touch screens cannot hover, so the credit is always shown there. */
  @media (hover: none) {
    .credit {
      opacity: 1;
    }
  }
  .title {
    position: relative;
    margin: 0;
    color: var(--white);
    font-family: var(--font-display);
    font-weight: 900;
    font-size: min(var(--fs-hero), var(--fit));
    line-height: 1.02;
    letter-spacing: var(--track-display);
    text-transform: uppercase;
    -webkit-text-stroke: 0.05em var(--blue-zodiac);
    paint-order: stroke fill;
    /* Never break inside a word; --fit sizes the longest line to the page. */
    overflow-wrap: normal;
    word-break: keep-all;
    hyphens: none;
  }
  .small .title {
    font-size: min(clamp(2.2rem, 8vw, 7.4rem), var(--fit));
  }
  .kicker {
    display: block;
    font-weight: 500;
    font-size: 0.2em;
    letter-spacing: 0.5em;
    padding-bottom: 0.6em;
    -webkit-text-stroke: 0.14em var(--blue-zodiac);
  }
  .line {
    display: block;
  }
</style>
