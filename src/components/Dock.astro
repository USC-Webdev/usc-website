---
// Floating section nav, bottom centre: the page's quick links, one per
// numbered section, labelled "1.0 Section title". Highlights the section in
// view. A long list stays on one row and scrolls sideways; the highlighted
// link is kept in view.
interface Props {
  items: { href: string; label: string }[];
}
const { items } = Astro.props;
const split = (label: string) => {
  const m = label.match(/^(\d+\.\d+)\s+(.*)$/);
  return m ? { num: m[1], word: m[2] } : { num: '', word: label };
};
---

<nav class="dock" aria-label="On this page" data-dock>
  {
    items.map((item) => {
      const { num, word } = split(item.label);
      return (
        <a href={item.href}>
          {num && <span class="num">{num}</span>}
          <span class="word">{word}</span>
        </a>
      );
    })
  }
</nav>

<script>
  const dock = document.querySelector<HTMLElement>('[data-dock]');
  // Fade the edge(s) where more links are hidden, so the row reads as scrollable.
  if (dock) {
    const edges = () => {
      const max = dock.scrollWidth - dock.clientWidth;
      dock.classList.toggle('more-left', dock.scrollLeft > 2);
      dock.classList.toggle('more-right', dock.scrollLeft < max - 2);
    };
    dock.addEventListener('scroll', edges, { passive: true });
    window.addEventListener('resize', edges);
    edges();
  }
  if (dock && 'IntersectionObserver' in window) {
    const links = [...dock.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
    const targets = links
      .map((link) => document.getElementById(link.hash.slice(1)))
      .filter((el): el is HTMLElement => el !== null);
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          for (const link of links) {
            if (link.hash === `#${entry.target.id}`) {
              link.setAttribute('aria-current', 'true');
              // Scroll the dock (not the page) so the current link is centred.
              // Plain assignment: a smooth scrollTo here is cancelled while the page itself is scrolling.
              dock.scrollLeft = link.offsetLeft - (dock.clientWidth - link.offsetWidth) / 2;
            } else link.removeAttribute('aria-current');
          }
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    targets.forEach((t) => observer.observe(t));
  }
</script>

<style>
  .dock {
    position: sticky;
    bottom: 16px;
    z-index: 20;
    width: fit-content;
    max-width: min(calc(100% - 24px), 1200px);
    margin: 24px auto;
    background: var(--robot-white);
    border: var(--rule);
    border-radius: var(--r-control);
    padding: 5px;
    display: flex;
    gap: 2px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: var(--track-action);
    text-transform: uppercase;
  }
  .dock.more-right {
    mask-image: linear-gradient(to right, #000 calc(100% - 48px), transparent);
  }
  .dock.more-left {
    mask-image: linear-gradient(to left, #000 calc(100% - 48px), transparent);
  }
  .dock.more-left.more-right {
    mask-image: linear-gradient(to right, transparent, #000 48px, #000 calc(100% - 48px), transparent);
  }
  .dock::-webkit-scrollbar {
    display: none;
  }
  a {
    flex: none;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6em;
    min-height: 44px;
    min-width: 48px;
    padding: 0 18px;
    border-radius: var(--r-control);
    text-decoration: none;
    color: var(--blue-zodiac);
  }
  a[aria-current] {
    background: var(--blue-zodiac);
    color: var(--white);
  }
  a[aria-current]:focus-visible {
    outline-color: var(--blue-zodiac);
  }
  @media (max-width: 560px) {
    a {
      min-height: 48px;
      padding: 0 12px;
    }
    .dock {
      font-size: 12px;
    }
  }
</style>
