---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// YouTube card. It is a plain link to YouTube; with JavaScript, a click swaps
// in a youtube-nocookie embed (no iframe until the click).
interface Props {
  youtubeId: string;
  title: string;
  num: string;
  shape?: 'wide' | 'tall';
  poster?: ImageMetadata;
  posterAlt?: string;
  offset?: boolean;
  titlePlaceholder?: boolean;
}
const { youtubeId, title, num, shape = 'wide', poster, posterAlt = '', offset = false, titlePlaceholder = false } = Astro.props;
---

<div class:list={['video', shape, { offset }]}>
  <a
    class="screen"
    href={`https://www.youtube.com/watch?v=${youtubeId}`}
    data-youtube={youtubeId}
    data-title={title}
    rel="noopener"
  >
    {poster && <Image src={poster} alt={posterAlt} widths={[480, 960]} sizes="(min-width: 900px) 50vw, 100vw" class="poster" />}
    <span class="top label">
      <span>{num}</span>
      <span>YouTube</span>
    </span>
    <span class="play">
      <svg aria-hidden="true" width="14" height="16" viewBox="0 0 14 16">
        <path d="M0 0 L14 8 L0 16 Z" fill="#EE302A"></path>
      </svg>
      Play<span class="visually-hidden">: {title}</span>
    </span>
    <span class="baseline" aria-hidden="true"></span>
  </a>
  <p class="video-title">
    {title}
    {titlePlaceholder && <span class="ph-badge">Placeholder title</span>}
  </p>
</div>

<script>
  document.querySelectorAll<HTMLAnchorElement>('a[data-youtube]').forEach((link) => {
    link.addEventListener('click', (event) => {
      if (event.metaKey || event.ctrlKey || event.shiftKey) return;
      event.preventDefault();
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${link.dataset.youtube}?autoplay=1`;
      iframe.title = link.dataset.title ?? 'YouTube video';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.className = 'embed';
      link.replaceWith(iframe);
      iframe.focus();
    });
  });
</script>

<style>
  .video {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
    color: var(--white);
  }
  .wide {
    flex: 1.45 1 380px;
  }
  .tall {
    flex: 1 1 300px;
  }
  .offset {
    margin-top: clamp(0px, 9vw, 130px);
  }
  .screen,
  .video :global(.embed) {
    width: 100%;
    border: 1px solid var(--steel-grey);
    background: rgba(255, 255, 255, 0.05);
  }
  .wide .screen,
  .wide :global(.embed) {
    aspect-ratio: 16 / 10;
  }
  .tall .screen,
  .tall :global(.embed) {
    aspect-ratio: 4 / 5;
  }
  .screen {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 22px;
    color: var(--white);
    text-decoration: none;
    overflow: hidden;
  }
  .screen:hover {
    color: var(--white);
  }
  .screen:focus-visible {
    outline-color: var(--white);
  }
  .poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.55;
  }
  .top {
    position: relative;
    display: flex;
    justify-content: space-between;
  }
  .play {
    position: relative;
    align-self: center;
    background: var(--white);
    color: var(--blue-zodiac);
    border-radius: var(--r-control);
    padding: 18px 30px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 16px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 12px;
    transition: transform 0.25s;
  }
  .screen:hover .play {
    transform: scale(1.05);
  }
  .baseline {
    position: relative;
    height: 1px;
    background: var(--steel-grey);
  }
  .video-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 22px;
    line-height: 1.3;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 12px;
    align-items: center;
  }
</style>
