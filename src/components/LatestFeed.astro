---
import { Image } from 'astro:assets';
import HexArrow from './HexArrow.astro';
import SectionHead from './SectionHead.astro';
import { formatDate } from '../lib/content';
import type { FeedItem } from '../lib/feed';

// Home carousel (Latest Updates, Affiliated Creators): a row of cards (picture, source and date, title,
// short text; screenshots from the pool show their caption and credit instead)
// that scrolls sideways and snaps card by card. Three cards show on
// wide screens, two on tablets, one and a peek of the next on phones. Swipe,
// scroll or use the Previous/Next buttons; without JavaScript the row still
// scrolls. Items without a picture get a Blue Zodiac tile with the source
// name. Data comes from getFeeds() in src/lib/feed.ts.
interface Props {
  /** Unique per page: the Previous/Next buttons point at it. */
  id: string;
  heading: string;
  items: FeedItem[];
}
const { id, heading, items } = Astro.props;
const sizes = '(min-width: 1000px) 30vw, (min-width: 640px) 45vw, 85vw';
---

<div class="carousel" data-carousel>
  <SectionHead title={heading}>
  <div class="controls" hidden data-controls>
    <button type="button" class="nav" data-prev aria-label={`Previous: ${heading}`} aria-controls={id}>
      <span aria-hidden="true">←</span>
    </button>
    <button type="button" class="nav" data-next aria-label={`Next: ${heading}`} aria-controls={id}>
      <span aria-hidden="true">→</span>
    </button>
  </div>
  </SectionHead>
<ul class="feed" id={id} aria-label={heading} tabindex="0">
  {
    items.map((item) => {
      const Tag = item.href ? 'a' : 'div';
      return (
        <li>
          <Tag class:list={['card', { link: !!item.href }]} href={item.href} {...(item.external ? { rel: 'noopener' } : {})}>
            <span class="pic">
              {item.image ? (
                <Image src={item.image} alt={item.alt} widths={[400, 800]} sizes={sizes} class="img" />
              ) : item.remoteImage ? (
                <Image src={item.remoteImage} alt={item.alt} inferSize widths={[400, 800]} sizes={sizes} class="img" />
              ) : (
                <span class="tile label" aria-hidden="true">
                  {item.source}
                </span>
              )}
            </span>
            <span class="meta label">
              <span>{item.source}</span>
              {item.kind !== 'screenshot' && <time datetime={item.date.toISOString().slice(0, 10)}>{formatDate(item.date)}</time>}
            </span>
            {item.title && <span class="title">{item.title}</span>}
            {item.credit && <span class="credit">{item.credit}</span>}
            {item.text && <span class="text">{item.text}</span>}
            {item.href && (
              <span class="go">
                <HexArrow size={44} />
                {item.external && <span class="visually-hidden">(opens {item.source.replace(/ ·.*/, '')})</span>}
              </span>
            )}
          </Tag>
        </li>
      );
    })
  }
</ul>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.feed');
    const controls = root.querySelector<HTMLElement>('[data-controls]');
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-next]');
    if (!track || !controls || !prev || !next) return;
    // One step is one card plus the gap.
    const step = () => {
      const card = track.querySelector('li');
      return card ? card.getBoundingClientRect().width + parseFloat(getComputedStyle(track).columnGap || '0') : track.clientWidth;
    };
    const update = () => {
      const max = track.scrollWidth - track.clientWidth;
      controls.hidden = max <= 2;
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= max - 2;
    };
    const go = (dir: number) => {
      const max = track.scrollWidth - track.clientWidth;
      track.scrollTo({ left: Math.max(0, Math.min(max, track.scrollLeft + dir * step())) });
    };
    prev.addEventListener('click', () => go(-1));
    next.addEventListener('click', () => go(1));
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  });
</script>

<style>
  .carousel {
    position: relative;
  }
  /* The last card can't reach the left edge, so it snaps to the right one. */
  .feed > li:last-child {
    scroll-snap-align: end;
  }
  .controls {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
  }
  .controls[hidden] {
    display: none;
  }
  .nav {
    width: var(--target-min);
    height: var(--target-min);
    border: 1px solid var(--blue-zodiac);
    border-radius: 50%;
    background: transparent;
    color: var(--blue-zodiac);
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
  }
  .nav:hover:not(:disabled) {
    background: var(--blue-zodiac);
    color: var(--white);
  }
  .nav:disabled {
    opacity: 0.3;
    cursor: default;
  }
  .feed {
    --gap: 28px;
    --per-view: 3;
    list-style: none;
    margin: 0;
    padding: 0 0 8px;
    display: flex;
    gap: var(--gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  .feed::-webkit-scrollbar {
    display: none;
  }
  .feed:focus-visible {
    outline-offset: 4px;
  }
  .feed > li {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
    min-width: 0;
    /* Containing block for the visually hidden link text, so it stays inside the scroller. */
    position: relative;
    scroll-snap-align: start;
  }
  @media (max-width: 999px) {
    .feed {
      --per-view: 2;
    }
  }
  @media (max-width: 639px) {
    .feed {
      --gap: 16px;
    }
    .feed > li {
      flex-basis: 85%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .feed {
      scroll-behavior: auto;
    }
  }
  .card {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 12px;
    color: var(--blue-zodiac);
    text-decoration: none;
    border-top: var(--rule);
    padding-top: 16px;
  }
  .pic {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--blue-zodiac);
  }
  .pic :global(.img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s;
  }
  .card.link:hover :global(.img) {
    transform: scale(1.04);
  }
  .tile {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--white);
    font-size: 15px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 12px;
  }
  .title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 20px;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }
  .card.link:hover .title {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .credit {
    font-size: 14px;
    font-style: italic;
  }
  .text {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .go {
    margin-top: auto;
    padding-top: 4px;
  }
</style>
