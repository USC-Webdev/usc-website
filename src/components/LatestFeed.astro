---
import { Image } from 'astro:assets';
import HexArrow from './HexArrow.astro';
import { formatDate } from '../lib/content';
import type { FeedItem } from '../lib/feed';

// "Latest updates" cards: picture, source and date, title, short text. The
// whole card is the link. Items without a picture get a Blue Zodiac tile with
// the source name. Data comes from getFeed() in src/lib/feed.ts.
interface Props {
  items: FeedItem[];
}
const { items } = Astro.props;
const sizes = '(min-width: 1100px) 30vw, (min-width: 700px) 45vw, 100vw';
---

<ul class="feed">
  {
    items.map((item) => {
      const Tag = item.href ? 'a' : 'div';
      return (
        <li>
          <Tag class:list={['card', { link: !!item.href }]} href={item.href} {...(item.external ? { rel: 'noopener' } : {})}>
            <span class="pic">
              {item.image ? (
                <Image src={item.image} alt={item.alt} widths={[400, 800]} sizes={sizes} class="img" />
              ) : item.remoteImage ? (
                <Image src={item.remoteImage} alt={item.alt} inferSize widths={[400, 800]} sizes={sizes} class="img" />
              ) : (
                <span class="tile label" aria-hidden="true">
                  {item.source}
                </span>
              )}
            </span>
            <span class="meta label">
              <span>{item.source}</span>
              <time datetime={item.date.toISOString().slice(0, 10)}>{formatDate(item.date)}</time>
            </span>
            <span class="title">{item.title}</span>
            {item.text && <span class="text">{item.text}</span>}
            {item.href && (
              <span class="go">
                <HexArrow size={44} />
                {item.external && <span class="visually-hidden">(opens {item.source.replace(/ ·.*/, '')})</span>}
              </span>
            )}
          </Tag>
        </li>
      );
    })
  }
</ul>

<style>
  .feed {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 32px 28px;
  }
  .card {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 12px;
    color: var(--blue-zodiac);
    text-decoration: none;
    border-top: var(--rule);
    padding-top: 16px;
  }
  .pic {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--blue-zodiac);
  }
  .pic :global(.img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s;
  }
  .card.link:hover :global(.img) {
    transform: scale(1.04);
  }
  .tile {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--white);
    font-size: 15px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 12px;
  }
  .title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 20px;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }
  .card.link:hover .title {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .text {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .go {
    margin-top: auto;
    padding-top: 4px;
  }
</style>
