---
import { Image } from 'astro:assets';
import HexArrow from './HexArrow.astro';
import SectionHead from './SectionHead.astro';
import { formatDate } from '../lib/content';
import type { FeedItem } from '../lib/feed';

// Card carousel: Latest Updates on Home, USC in the 'Verse on Media Network.
// A row of cards (picture, source and date, title, short text; screenshots
// show their caption and credit instead) that scrolls sideways and snaps card
// by card. Three cards show on wide screens, two on tablets, one and a peek of
// the next on phones. Swipe, scroll or use the Previous/Next buttons; without
// JavaScript the row still scrolls. Items without a picture get a Blue Zodiac
// tile with the source name. `more` adds a closing link card. `pick` shows
// that many items chosen at random on each page load (without JavaScript, the
// first ones). Data comes from src/lib/feed.ts.
interface Props {
  /** Unique per page: the Previous/Next buttons point at it. */
  id: string;
  heading: string;
  /** Optional line of body text under the heading. */
  intro?: string;
  items: FeedItem[];
  /** Closing card linking onwards, for example to the Media Network page. */
  more?: { href: string; label: string; source: string; title: string };
  /** Show this many items, picked at random on each page load. */
  pick?: number;
}
const { id, heading, intro, items, more, pick } = Astro.props;
const shown = pick ? Math.min(pick, items.length) : items.length;
const sizes = '(min-width: 1000px) 30vw, (min-width: 640px) 45vw, 85vw';
---

<div class="carousel" data-carousel data-pick={pick ? shown : undefined}>
  <SectionHead title={heading}>
  <div class="controls" hidden data-controls>
    <button type="button" class="nav" data-prev aria-label={`Previous: ${heading}`} aria-controls={id}>
      <span aria-hidden="true">←</span>
    </button>
    <button type="button" class="nav" data-next aria-label={`Next: ${heading}`} aria-controls={id}>
      <span aria-hidden="true">→</span>
    </button>
  </div>
  </SectionHead>
  {intro && <p class="intro">{intro}</p>}
<ul class="feed" id={id} aria-label={heading} tabindex="0">
  {
    items.map((item, i) => {
      const Tag = item.href ? 'a' : 'div';
      return (
        <li hidden={i >= shown} class:list={{ end: !more && i === shown - 1 }}>
          <Tag class:list={['card', { link: !!item.href }]} href={item.href} {...(item.external ? { rel: 'noopener' } : {})}>
            <span class="pic">
              {item.image ? (
                <Image src={item.image} alt={item.alt} widths={[400, 800]} sizes={sizes} class="img" />
              ) : item.remoteImage ? (
                <Image src={item.remoteImage} alt={item.alt} inferSize widths={[400, 800]} sizes={sizes} class="img" />
              ) : (
                <span class="tile label" aria-hidden="true">
                  {item.source}
                </span>
              )}
            </span>
            <span class="meta label">
              <span>{item.source}</span>
              {item.kind !== 'screenshot' && <time datetime={item.date.toISOString().slice(0, 10)}>{formatDate(item.date)}</time>}
            </span>
            {(item.title || item.href) && (
              <span class="head">
                <span class="title">{item.title}</span>
                {item.href && (
                  <span class="go">
                    <HexArrow size={40} />
                    {item.external && <span class="visually-hidden">(opens {item.source.replace(/ ·.*/, '')})</span>}
                  </span>
                )}
              </span>
            )}
            {item.credit && <span class="credit">{item.credit}</span>}
            {item.text && <span class="text">{item.text}</span>}
          </Tag>
        </li>
      );
    })
  }
  {
    more && (
      <li class="end">
        <a class="card link more" href={more.href}>
          <span class="pic more-box">
            <span class="more-title">{more.label}</span>
          </span>
          <span class="meta label">
            <span>{more.source}</span>
          </span>
          <span class="head">
            <span class="title">{more.title}</span>
            <span class="go">
              <HexArrow size={40} />
            </span>
          </span>
        </a>
      </li>
    )
  }
</ul>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.feed');
    const controls = root.querySelector<HTMLElement>('[data-controls]');
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-next]');
    if (!track || !controls || !prev || !next) return;
    // Random pick: shuffle every item, show the first `pick`, mark the last shown one.
    const pick = Number(root.dataset.pick);
    if (pick) {
      const all = [...track.children] as HTMLElement[];
      for (let i = all.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [all[i], all[j]] = [all[j], all[i]];
      }
      all.forEach((li, i) => {
        li.hidden = i >= pick;
        li.classList.toggle('end', i === pick - 1);
        track.append(li);
      });
    }
    // One step is one card plus the gap.
    const step = () => {
      const card = track.querySelector('li');
      return card ? card.getBoundingClientRect().width + parseFloat(getComputedStyle(track).columnGap || '0') : track.clientWidth;
    };
    const update = () => {
      const max = track.scrollWidth - track.clientWidth;
      controls.hidden = max <= 2;
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= max - 2;
    };
    const go = (dir: number) => {
      const max = track.scrollWidth - track.clientWidth;
      track.scrollTo({ left: Math.max(0, Math.min(max, track.scrollLeft + dir * step())) });
    };
    prev.addEventListener('click', () => go(-1));
    next.addEventListener('click', () => go(1));
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  });
</script>

<style>
  .carousel {
    position: relative;
  }
  /* The last card can't reach the left edge, so it snaps to the right one. */
  .feed > li.end {
    scroll-snap-align: end;
  }
  .intro {
    max-width: 640px;
    margin: -12px 0 28px;
    font-size: 19px;
    line-height: 1.5;
  }
  .controls {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
  }
  .controls[hidden] {
    display: none;
  }
  .nav {
    width: var(--target-min);
    height: var(--target-min);
    border: 1px solid var(--blue-zodiac);
    border-radius: 50%;
    background: transparent;
    color: var(--blue-zodiac);
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
  }
  .nav:hover:not(:disabled) {
    background: var(--blue-zodiac);
    color: var(--white);
  }
  .nav:disabled {
    opacity: 0.3;
    cursor: default;
  }
  .feed {
    --gap: 28px;
    --per-view: 3;
    list-style: none;
    margin: 0;
    padding: 0 0 8px;
    display: flex;
    gap: var(--gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  .feed::-webkit-scrollbar {
    display: none;
  }
  .feed:focus-visible {
    outline-offset: 4px;
  }
  .feed > li {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
    min-width: 0;
    /* Containing block for the visually hidden link text, so it stays inside the scroller. */
    position: relative;
    scroll-snap-align: start;
  }
  @media (max-width: 999px) {
    .feed {
      --per-view: 2;
    }
  }
  @media (max-width: 639px) {
    .feed {
      --gap: 16px;
    }
    .feed > li {
      flex-basis: 85%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .feed {
      scroll-behavior: auto;
    }
  }
  /* Closing card: a Blue Zodiac box the size of the other cards' pictures, text centred. */
  .pic.more-box {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 16px;
    color: var(--white);
    text-align: center;
  }
  .more-title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    line-height: 1.15;
  }
  .card {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 12px;
    color: var(--blue-zodiac);
    text-decoration: none;
    border-top: var(--rule);
    padding-top: 16px;
  }
  .pic {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--blue-zodiac);
  }
  .pic :global(.img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s;
  }
  .card.link:hover :global(.img) {
    transform: scale(1.04);
  }
  .tile {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--white);
    font-size: 15px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 12px;
  }
  .title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 20px;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }
  .card.link:hover .title {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .credit {
    font-size: 14px;
    font-style: italic;
  }
  .text {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  /* Title and arrow share a line; the arrow sits at the right end. */
  .head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }
  .head .title {
    flex: 1 1 auto;
    min-width: 0;
  }
  .go {
    flex: none;
    display: flex;
  }
</style>
