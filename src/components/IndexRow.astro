---
import HexArrow from './HexArrow.astro';
import MinistryMark from './MinistryMark.astro';
import type { ImageMetadata } from 'astro';

// Number, title, sentence, hexagon arrow. The whole row is the link and flips
// to Blue Zodiac on hover. Without href it renders as a static row.
interface Props {
  num: string;
  title: string;
  text?: string;
  href?: string;
  last?: boolean;
  mark?: { image?: ImageMetadata; abbreviation: string };
}
const { num, title, text, href, last = false, mark } = Astro.props;
const Tag = href ? 'a' : 'div';
const external = href ? /^https?:\/\//.test(href) : false;
---

<Tag
  class:list={['row', { last, link: !!href }]}
  href={href}
  {...external ? { rel: 'noopener' } : {}}
>
  <span class="num">{num}</span>
  {
    mark && (
      <span class="mark">
        <MinistryMark mark={mark.image} abbreviation={mark.abbreviation} size={56} />
      </span>
    )
  }
  <span class="title">{title}</span>
  {text && <span class="text">{text}</span>}
  {href && <HexArrow />}
</Tag>

<style>
  .row {
    color: var(--blue-zodiac);
    border-top: var(--rule);
    padding: 26px 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 40px;
    text-decoration: none;
    transition: background-color 0.3s, color 0.3s, padding 0.3s;
  }
  .row.last {
    border-bottom: var(--rule);
  }
  .row.link:hover,
  .row.link:focus-visible {
    background: var(--blue-zodiac);
    color: var(--white);
    padding-left: 28px;
    padding-right: 28px;
  }
  .row.link:hover .mark,
  .row.link:focus-visible .mark {
    background: var(--robot-white);
  }
  .num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 14px;
    flex: 0 0 48px;
  }
  .mark {
    flex: 0 0 auto;
    padding: 4px;
    background: var(--robot-white);
  }
  .title {
    flex: 3 1 420px;
    min-width: 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--fs-h3);
    line-height: 1.1;
    overflow-wrap: anywhere;
  }
  .text {
    flex: 1 1 260px;
    min-width: 0;
  }
</style>
