---
import Logo from './Logo.astro';
import type { SiteSettings } from '../lib/types';

interface Props {
  settings: SiteSettings;
}
const { settings } = Astro.props;
---

<footer class="footer">
  <div class="wrap grid">
    <div class="brand">
      <div class="logo-space">
        <Logo variant="footer" />
      </div>
      <span class="tagline">{settings.tagline}</span>
      {settings.footerText && <p class="footer-text">{settings.footerText}</p>}
    </div>
    <div class="channels">
      <span class="label">Channels</span>
      <nav aria-label="Channels" class="links">
        {
          settings.channels.map((c) => (
            <a href={c.href} rel="noopener">
              {c.label}
            </a>
          ))
        }
      </nav>
      <a href={`mailto:${settings.contactEmail}`} class="email">{settings.contactEmail}</a>
    </div>
  </div>
  <div class="marquee" aria-hidden="true">
    <div class="track">UNITED SPACE CONFEDERATION &nbsp;/&nbsp; UNITED SPACE CONFEDERATION &nbsp;/&nbsp;&nbsp;</div>
  </div>
</footer>

<style>
  .footer {
    background: var(--robot-white);
    border-top: var(--rule);
    overflow: hidden;
  }
  .grid {
    padding-top: 56px;
    padding-bottom: 24px;
    display: flex;
    flex-wrap: wrap;
    gap: 32px 56px;
    justify-content: space-between;
    align-items: flex-start;
  }
  .brand {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }
  .logo-space {
    padding: 20px 20px 20px 0;
  }
  .tagline {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 15px;
    letter-spacing: 0.14em;
    overflow-wrap: anywhere;
  }
  .footer-text {
    max-width: 46ch;
    font-size: 15px;
  }
  .channels {
    display: flex;
    flex-direction: column;
    gap: 6px;
    border-left: var(--rule);
    padding-left: 24px;
    min-width: 0;
  }
  .channels .label {
    padding-bottom: 6px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
    max-width: 420px;
  }
  .links a,
  .email {
    padding: 11px 0;
    min-height: var(--target-min);
    display: inline-flex;
    align-items: center;
    overflow-wrap: anywhere;
  }
  .marquee {
    white-space: nowrap;
    overflow: hidden;
    padding: 16px 0 28px;
  }
  .track {
    display: inline-block;
    animation: usc-marq 50s linear infinite;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(3rem, 9vw, 8.4rem);
    line-height: 1.1;
    letter-spacing: 0.02em;
    color: transparent;
    -webkit-text-stroke: 2px var(--blue-zodiac);
  }
</style>
