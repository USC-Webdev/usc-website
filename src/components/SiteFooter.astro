---
import Logo from './Logo.astro';
import type { SiteSettings } from '../lib/types';

interface Props {
  settings: SiteSettings;
}
const { settings } = Astro.props;
---

<footer class="footer">
  <div class="wrap grid">
    <div class="brand">
      <div class="logo-space">
        <Logo variant="footer" />
      </div>
      <span class="tagline">{settings.tagline}</span>
      {settings.footerText && <p class="footer-text">{settings.footerText}</p>}
    </div>
    <div class="col channels">
      <span class="label">Channels</span>
      <nav aria-label="Channels" class="links">
        {
          settings.channels.map((c) => (
            <a href={c.href} rel="noopener">
              {c.label}
            </a>
          ))
        }
      </nav>
      <a href={`mailto:${settings.contactEmail}`} class="email">{settings.contactEmail}</a>
    </div>
    {
      settings.affiliates.length > 0 && (
        <div class="col affiliates">
          <span class="label">Affiliates</span>
          <nav aria-label="Affiliates" class="affiliate-links">
            {settings.affiliates.map((a) => (
              <a href={a.href} rel="noopener">
                {a.label}
              </a>
            ))}
          </nav>
        </div>
      )
    }
  </div>
  <div class="marquee" aria-hidden="true">
    <div class="track">UNITED SPACE CONFEDERATION &nbsp;/&nbsp; UNITED SPACE CONFEDERATION &nbsp;/&nbsp;&nbsp;</div>
  </div>
</footer>

<style>
  .footer {
    background: var(--robot-white);
    border-top: var(--rule);
    overflow: hidden;
  }
  /* Brand left, channels centred, affiliates right; stacked on narrow screens. */
  .grid {
    padding-top: 56px;
    padding-bottom: 24px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 32px 56px;
    align-items: start;
  }
  .affiliates {
    justify-self: end;
  }
  @media (max-width: 1100px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
    .brand {
      grid-column: 1 / -1;
    }
    .affiliates {
      justify-self: start;
    }
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
  .brand {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }
  .logo-space {
    padding: 20px 20px 20px 0;
  }
  .tagline {
    font-family: var(--font-display);
    font-weight: 400;
    /* Scales down on phones so the tagline stays on one line. */
    font-size: clamp(11px, 3.4vw, 15px);
    letter-spacing: 0.14em;
    white-space: nowrap;
  }
  .footer-text {
    max-width: 46ch;
    font-size: 15px;
  }
  .col {
    display: flex;
    flex-direction: column;
    gap: 6px;
    border-left: var(--rule);
    padding-left: 24px;
    min-width: 0;
  }
  .col .label {
    padding-bottom: 6px;
  }
  .affiliate-links {
    display: flex;
    flex-direction: column;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
    max-width: 420px;
  }
  .links a,
  .affiliate-links a,
  .email {
    padding: 11px 0;
    min-height: var(--target-min);
    display: inline-flex;
    align-items: center;
    overflow-wrap: anywhere;
  }
  .marquee {
    white-space: nowrap;
    overflow: hidden;
    padding: 16px 0 28px;
  }
  .track {
    display: inline-block;
    animation: usc-marq 50s linear infinite;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(3rem, 9vw, 8.4rem);
    line-height: 1.1;
    letter-spacing: 0.02em;
    color: transparent;
    -webkit-text-stroke: 2px var(--blue-zodiac);
  }
</style>
