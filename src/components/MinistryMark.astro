---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Shows a ministry mark, or a clearly marked hexagon placeholder with the
// ministry's abbreviation until the brand-package mark is supplied.
interface Props {
  mark?: ImageMetadata;
  abbreviation: string;
  size?: number;
}
const { mark, abbreviation, size = 52 } = Astro.props;
---

{
  mark ? (
    <Image src={mark} alt="" width={size} densities={[1, 2]} class="mark" />
  ) : (
    <span class="mark-ph" style={`width:${size}px`} data-placeholder={`Ministry mark: ${abbreviation}`}>
      <svg aria-hidden="true" viewBox="0 0 44 40" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M12 2 H32 L42 20 L32 38 H12 L2 20 Z" stroke-dasharray="4 3" />
        <text x="22" y="24" text-anchor="middle" fill="currentColor" stroke="none" font-size={abbreviation.length > 3 ? 7.5 : 10} font-weight="700" font-family="var(--font-display)">
          {abbreviation}
        </text>
      </svg>
    </span>
  )
}

<style>
  .mark {
    height: auto;
    flex: 0 0 auto;
  }
  .mark-ph {
    display: inline-flex;
    flex: 0 0 auto;
    color: var(--blue-zodiac);
  }
  .mark-ph svg {
    width: 100%;
    height: auto;
  }
</style>
