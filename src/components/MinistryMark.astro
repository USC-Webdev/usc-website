---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Shows a ministry mark. Without one (the USC Navy has none) it shows the
// plain hexagon outline from Mockup A.
interface Props {
  mark?: ImageMetadata;
  abbreviation: string;
  size?: number;
}
const { mark, abbreviation, size = 52 } = Astro.props;
---

{
  mark ? (
    <Image src={mark} alt="" width={size} densities={[1, 2]} class="mark" />
  ) : (
    <span class="mark-ph" style={`width:${size}px`}>
      <svg aria-hidden="true" viewBox="0 0 44 40" fill="none" stroke="currentColor" stroke-width="3">
        <path d="M12 2 H32 L42 20 L32 38 H12 L2 20 Z" />
      </svg>
    </span>
  )
}

<style>
  .mark {
    height: auto;
    flex: 0 0 auto;
  }
  .mark-ph {
    display: inline-flex;
    flex: 0 0 auto;
    color: var(--blue-zodiac);
  }
  .mark-ph svg {
    width: 100%;
    height: auto;
  }
</style>
