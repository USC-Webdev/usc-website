---
// Decorative strip of diagonal capsules. Rows come from a seeded generator so
// the band is identical on every build. One per page, between a light and a
// dark section.
interface Props {
  seed?: number;
}
const { seed = 2956 } = Astro.props;

function rng(s: number) {
  let t = s >>> 0;
  return () => {
    t += 0x6d2b79f5;
    let r = Math.imul(t ^ (t >>> 15), 1 | t);
    r ^= r + Math.imul(r ^ (r >>> 7), 61 | r);
    return ((r ^ (r >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = rng(seed);
const accents = ['var(--ruby-red)', 'var(--topaz)', 'var(--clover-green)', 'var(--sunshade)', 'var(--steel-grey)'];
const rows = Array.from({ length: 7 }, (_, i) => {
  const capsules = Array.from({ length: 14 }, () => ({
    width: Math.round(70 + rand() * 190),
    color: rand() < 0.42 ? accents[Math.floor(rand() * accents.length)] : 'rgba(255,255,255,0.08)',
  }));
  return {
    capsules,
    duration: Math.round(40 + rand() * 42),
    reverse: i % 2 === 1,
    offset: Math.round(rand() * -120),
  };
});
---

<div class="band" aria-hidden="true">
  <div class="tilt">
    {
      rows.map((row) => (
        <div
          class:list={['row', { reverse: row.reverse }]}
          style={`animation-duration:${row.duration}s;margin-left:${row.offset}px`}
        >
          {[...row.capsules, ...row.capsules].map((c) => (
            <span class="capsule" style={`width:${c.width}px;background:${c.color}`} />
          ))}
        </div>
      ))
    }
  </div>
</div>

<style>
  .band {
    position: relative;
    background: var(--blue-zodiac);
    height: clamp(180px, 22vw, 300px);
    overflow: hidden;
  }
  .tilt {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 2400px;
    display: flex;
    flex-direction: column;
    gap: 22px;
    transform: translate(-50%, -50%) rotate(-38deg);
  }
  .row {
    display: flex;
    gap: 22px;
    animation: usc-slide linear infinite alternate;
  }
  .row.reverse {
    animation-direction: alternate-reverse;
  }
  .capsule {
    flex: 0 0 auto;
    height: 46px;
    border-radius: var(--r-control);
  }
</style>
