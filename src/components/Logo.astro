---
import { Image } from 'astro:assets';
import logoWhite from '../assets/brand/logo-white.png';
import logoBlue from '../assets/brand/Logos_on_White_Main_Logo_USC_Format1_W.png';

// Format 1 lockup. Header: white logo on Blue Zodiac, 64px. Footer: blue
// logo on Robot White, 96px. Files come from the org's logo package
// (scripts/make-brand-assets.mjs).
interface Props {
  variant: 'header' | 'footer';
}
const { variant } = Astro.props;
---

{
  variant === 'header' ? (
    <Image src={logoWhite} alt="United Space Confederation" height={64} densities={[1, 2, 3]} loading="eager" class="header-logo" />
  ) : (
    <Image src={logoBlue} alt="United Space Confederation" height={96} densities={[1, 2]} class="footer-logo" />
  )
}

<style>
  .header-logo {
    height: 64px;
    width: auto;
    max-width: 100%;
  }
  .footer-logo {
    height: 96px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }
  @media (max-width: 480px) {
    .header-logo {
      height: 52px;
    }
  }
</style>
