---
// Template 3: Long-form (Our Vision).
import BaseLayout from '../layouts/BaseLayout.astro';
import CoverHero from '../components/CoverHero.astro';
import SectionHead from '../components/SectionHead.astro';
import RailBlock from '../components/RailBlock.astro';
import IndexRow from '../components/IndexRow.astro';
import Prose from '../components/Prose.astro';
import CapsuleBand from '../components/CapsuleBand.astro';
import NumberedSections from '../components/NumberedSections.astro';
import JoinBand from '../components/JoinBand.astro';
import { getSingleton } from '../lib/content';
import { renderMarkdoc } from '../lib/markdoc';

const page = await getSingleton('ourVision');
const ideasNum = page.sections.length + 1;
const creedNum = ideasNum + 1;
---

<BaseLayout
  title={page.title}
  description={page.description}
  dock={page.sections.map((s, i) => ({ href: `#s-${i + 1}`, label: `${i + 1}.0  ${s.heading}` }))}
>
  <CoverHero
    lines={page.heroLines}
    image={{ src: page.hero.image, alt: page.hero.alt, credit: page.hero.credit, creditStatus: page.hero.creditStatus }}
    size="small"
  />

  <NumberedSections sections={page.sections} />

  {
    page.ideasHeading && (
      <section class="wrap block" id={`s-${ideasNum}`}>
        <SectionHead num={`${ideasNum}.0`} title={page.ideasHeading} />
        <RailBlock label="USC">
          <Prose html={renderMarkdoc(page.ideas)} />
        </RailBlock>
      </section>
    )
  }

  {
    page.creed.length > 0 && (
      <section class="wrap block block-last" id={`s-${creedNum}`}>
        <SectionHead num={`${creedNum}.0`} title={page.creedHeading} />
        {page.creed.map((c, i) => (
          <IndexRow num={`${creedNum}.${i + 1}`} title={c.title} text={c.text} last={i === page.creed.length - 1} />
        ))}
        {page.closing && (
          <div class="closing">
            <Prose html={renderMarkdoc(page.closing)} class="rise" />
          </div>
        )}
      </section>
    )
  }

  <CapsuleBand seed={2944} />
  <JoinBand links={[{ href: '/policies', label: 'Policies' }]} />
</BaseLayout>

<style>
  .closing {
    padding-top: 40px;
    padding-left: calc(var(--rail) + 40px);
  }
  @media (max-width: 760px) {
    .closing {
      padding-left: 0;
    }
  }
</style>
