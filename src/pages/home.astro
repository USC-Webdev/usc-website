---
// Template 2: Home. Cover hero with the org name, philosophy as index rows,
// community sections as rail blocks, call to action to apply.
import BaseLayout from '../layouts/BaseLayout.astro';
import CoverHero from '../components/CoverHero.astro';
import SectionHead from '../components/SectionHead.astro';
import RailBlock from '../components/RailBlock.astro';
import IndexRow from '../components/IndexRow.astro';
import Prose from '../components/Prose.astro';
import CapsuleBand from '../components/CapsuleBand.astro';
import NumberedSections from '../components/NumberedSections.astro';
import JoinBand from '../components/JoinBand.astro';
import { getSingleton } from '../lib/content';
import { renderMarkdoc } from '../lib/markdoc';
import { getSite } from '../lib/site';

const page = await getSingleton('home');
const { settings } = await getSite();
const communityStart = 3;
const heroSections = [
  { href: '#s-1', label: `1.0  ${page.introHeading}` },
  { href: '#s-2', label: `2.0  ${page.philosophyHeading}` },
  ...page.community.map((c, i) => ({ href: `#s-${communityStart + i}`, label: `${communityStart + i}.0  ${c.heading}` })),
];
---

<BaseLayout
  title="United Space Confederation"
  description={page.description}
  dock={[
    { href: '#s-1', label: '1.0 About' },
    { href: '#s-2', label: '2.0 Values' },
    { href: `#s-${communityStart}`, label: `${communityStart}.0 Community` },
    { href: '#join', label: 'Join' },
  ]}
>
  <CoverHero
    kicker={page.heroKicker}
    lines={page.heroLines}
    image={{ src: page.hero.image, alt: page.hero.alt, credit: page.hero.credit, creditStatus: page.hero.creditStatus }}
    sections={heroSections}
  />

  <section class="wrap block" id="s-1">
    <SectionHead num="1.0" title={page.introHeading} />
    <RailBlock label={settings.tagline}>
      <Prose html={renderMarkdoc(page.intro)} class="rise" />
    </RailBlock>
  </section>

  <section class="wrap block" id="s-2">
    <SectionHead num="2.0" title={page.philosophyHeading} />
    {page.philosophy.map((p, i) => <IndexRow num={`2.${i + 1}`} title={p.title} text={p.text} last={i === page.philosophy.length - 1} />)}
  </section>

  <NumberedSections sections={page.community} start={communityStart} />

  <div class="block"></div>
  <CapsuleBand seed={2013} />
  <JoinBand links={[{ href: '/our-vision', label: 'Our Vision' }, { href: '/policies', label: 'Policies' }]} />
</BaseLayout>
